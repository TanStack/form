{
  "name": "@benchmarks/react-form-browser",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "compare": "node scripts/compare-results.mjs",
    "compare:open": "node scripts/compare-results.mjs --open",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test:browser": "pnpm run build && pnpm run test:speed:run && pnpm run test:memory:run",
    "test:memory": "pnpm run build && pnpm run test:memory:run",
    "test:memory:run": "playwright test --config ./playwright.config.ts --project chromium-memory",
    "test:speed": "pnpm run build && pnpm run test:speed:run",
    "test:speed:run": "playwright test --config ./playwright.config.ts --project chromium-speed",
    "test:types": "tsc"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "compare": {
        "cache": false
      },
      "compare:open": {
        "cache": false
      },
      "test:browser": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "test:memory": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "test:speed": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "test:types": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@tanstack/react-form": "workspace:*",
    "formik": "^2.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.80.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "25.0.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  }
}
