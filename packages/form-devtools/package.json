{
  "name": "@tanstack/form-devtools",
  "version": "0.2.32",
  "description": "Devtools, for TanStack form.",
  "author": "tannerlinsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/form.git",
    "directory": "packages/form-devtools"
  },
  "homepage": "https://tanstack.com/form",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "form",
    "devtools"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "test:eslint": "eslint ./src",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./production": {
      "import": {
        "types": "./dist/production.d.ts",
        "default": "./dist/production.js"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/bridge/index.*"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@ark-ui/solid": "^5.38.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/devtools": "^0.13.0",
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/devtools-ui": "^0.6.0",
    "@tanstack/devtools-utils": "^0.6.0",
    "@tanstack/form-core": "workspace:*",
    "@tanstack/pacer-lite": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuzzysort": "^3.1.0",
    "lucide-solid": "^1.30.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "resize-observer-polyfill": "^1.5.1",
    "solid-js": "^1.9.14",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.5"
  }
}
